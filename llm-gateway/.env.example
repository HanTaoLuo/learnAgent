DEEPSEEK_API_KEY=
# 真实 OpenAI / Anthropic 模型的首选 Key；未设置时会回退到 DEEPSEEK_API_KEY。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# OpenAI-compatible / Responses API endpoint
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Anthropic Messages API endpoint
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# 可选：真实 OpenAI / Anthropic 服务的自定义网关端点。
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
DEEPSEEK_TIMEOUT_SECONDS=60
# 提示词版本管理使用的 SQLite 文件。不要提交真实运行数据。
GATEWAY_DATABASE_PATH=./llm_gateway.db
# 本地管理页面。仅对 localhost 地址尝试自动打开浏览器。
GATEWAY_UI_AUTO_OPEN=true
GATEWAY_UI_URL=http://127.0.0.1:8000/
# 页面只控制文字显示速度，不降低 SSE 网络读取速度。
GATEWAY_UI_TYPEWRITER_INTERVAL_MS=35
GATEWAY_UI_TYPEWRITER_CHARS_PER_TICK=1
# 非流式生成仅重试上游 408、429 与 5xx；最大值固定不超过 3。
GENERATE_MAX_RETRIES=3
GENERATE_RETRY_INITIAL_DELAY_SECONDS=0.25
# 网关入口限流。0 表示关闭默认限流；专属模型值格式为 模型别名:RPM，逗号分隔。
MODEL_RATE_LIMIT_REQUESTS_PER_MINUTE=60
MODEL_RATE_LIMITS_PER_MINUTE=deepseek-v4-pro:30,deepseek-v4-flash:60
# SSE 生命周期控制
STREAM_FIRST_TOKEN_TIMEOUT_SECONDS=30
STREAM_IDLE_TIMEOUT_SECONDS=60
STREAM_MAX_RETRIES=3
HEARTBEAT_INTERVAL_SECONDS=15
# 流式请求未提供 max_output_tokens 时采用该默认值。
STREAM_DEFAULT_MAX_OUTPUT_TOKENS=1024
# 断开订阅后允许后台继续生成的时间，以及终态事件在内存中的保留时间。
STREAM_DISCONNECT_GRACE_SECONDS=60
STREAM_RUN_RETENTION_SECONDS=600
STREAM_RUN_CLEANUP_INTERVAL_SECONDS=1
STREAM_RUN_MAX_CACHED_RUNS=100
